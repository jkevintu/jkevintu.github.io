---
// 開場 + 捲動導覽。沒有 JS 時，章節會退回成一般的卡片列表。
import { CHAPTERS, HERO } from '../data/content';
import { totalLength } from '../lib/iso/camera';
import { TOUR_PHASES } from '../lib/iso/island';

const length = totalLength(TOUR_PHASES);
---

<section id="tour" class="tour" style={`--tour-length: ${length}`} aria-label="From fuzzy idea to working product">
  <div class="tour__stage" data-stage data-chapter="0" data-intro="true">
    <canvas class="tour__canvas" data-canvas aria-hidden="true"></canvas>
    <div class="tour__progress" aria-hidden="true"><span data-progress></span></div>

    <div class="tour__hero">
      <p class="eyebrow">{HERO.eyebrow}</p>
      <h1 class="hero__title">
        <span class="fuzzy">{HERO.lineA}</span>
        <span class="crisp">{HERO.lineB}<i class="cursor" aria-hidden="true"></i></span>
      </h1>
      <p class="hero__lede">{HERO.lede}</p>
      <p class="hero__now"><i aria-hidden="true"></i>{HERO.now}</p>
      <div class="hero__cta">
        <a class="btn" href="#tour-fog">Take the tour <span aria-hidden="true">↓</span></a>
        <a class="btn btn--ghost" href="#work">Skip to the work</a>
      </div>
    </div>

    <ol class="chapters">
      {
        CHAPTERS.map((c, i) => (
          <li class="chapter" id={`tour-${c.id}`} data-index={i + 1} style={`--accent: var(--${c.ink})`}>
            <article class="chapter__card">
              <header class="chapter__head">
                <span>
                  Stage {c.stage} / {String(CHAPTERS.length).padStart(2, '0')}
                </span>
                <span class="chapter__place" data-ink={c.ink}>
                  {c.place}
                </span>
              </header>
              <h2>{c.title}</h2>
              <p>{c.body}</p>
              <ul class="tags">
                {c.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>

    <nav class="hud" aria-label="Tour stages">
      {
        CHAPTERS.map((c, i) => (
          <button type="button" data-pip={i + 1} data-name={c.place}>
            <span class="hud__label">{c.place}</span>
            <i aria-hidden="true" />
            <span class="sr-only">Go to stage {c.stage}: {c.place}</span>
          </button>
        ))
      }
    </nav>

    <p class="tour__hint" aria-hidden="true">Scroll to play<i></i></p>
    <span class="tour__label" data-hover-label hidden></span>
  </div>
</section>

<script>
  import { initTour } from '../scripts/tour';

  const root = document.getElementById('tour');
  if (root) initTour(root);

  // 「Take the tour」與章節錨點：跳到對應章節抵達的位置，而不是 li 本身
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#tour-"]').forEach((a) =>
    a.addEventListener('click', (e) => {
      const target = document.querySelector<HTMLButtonElement>(
        `[data-pip="${[...document.querySelectorAll('.chapter')].findIndex((c) => `#${c.id}` === a.hash) + 1}"]`,
      );
      if (!target) return;
      e.preventDefault();
      target.click();
    }),
  );
</script>
